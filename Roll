# This example shows a dice with the possible options being the numbers from 1 to 6

import random

# You can put your own outcomes here

OPTIONS = ["You got '1'", "You got '2'", "You got '3'", "You got '4'", "You got '5'", "You got '6'"]

# This defines the "throw" function

def throw():
    return random.choice(OPTIONS)

# You can change the print line and choices to something else

def main():
    print("Type 'throw' to start - 'quit' to stop")
    while True:
        choice = input("Make your move").strip().lower()
        if choice == "throw":
            print(throw())
        elif choice == "quit":
            break
                print("Thank you for using the Simple-RNG")
        else:
            print("Invalid Option")
main()